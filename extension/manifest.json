{
  "manifest_version": 3,
  "name": "Chrome Session Sync",
  "version": "1.0.0",
  "description": "Keeps chosen sites' sign-ins in step between your own machines, encrypted before it leaves the browser.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["cookies", "alarms", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_title": "Chrome Session Sync" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
